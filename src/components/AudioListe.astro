---
import Kopfhoerer from './Kopfhoerer.astro';

interface Props {
  stuecke: { src: string; titel: string; mitwirkende: string; beschreibung: string }[];
  ueberschrift?: string;
  tipp?: boolean;
  kennung?: string;
}
const { stuecke, ueberschrift = '', tipp = true, kennung = 'audio' } = Astro.props;
---
<section class="audio" aria-labelledby={`${kennung}-titel`}>
  {ueberschrift ? (
    <h2 id={`${kennung}-titel`} class="audio-abschnitt">{ueberschrift}</h2>
  ) : (
    <h2 id={`${kennung}-titel`} class="visually-hidden">Zum Anhören</h2>
  )}

  {stuecke.length === 0 ? (
    <p class="audio-leer">Hier erklingt bald Musik. Schau gern später noch einmal vorbei.</p>
  ) : (
    <>
      {tipp && (
        <p class="audio-tipp">
          <Kopfhoerer groesse={22} />
          <span>Am schönsten mit Kopfhörern</span>
        </p>
      )}
      <ol class="audio-liste">
        {stuecke.map((s, i) => (
          <li class="audio-stueck">
            <p class="audio-titel" id={`${kennung}-${i}`}>{s.titel}</p>
            {s.mitwirkende && <p class="audio-mitwirkende">{s.mitwirkende}</p>}
            {s.beschreibung && <p class="audio-beschreibung">{s.beschreibung}</p>}
            <audio controls preload="none" src={s.src} aria-labelledby={`${kennung}-${i}`}>
              <a href={s.src}>{s.titel} herunterladen</a>
            </audio>
          </li>
        ))}
      </ol>
    </>
  )}
</section>

<script>
  // Immer nur ein Stück gleichzeitig abspielen.
  document.addEventListener(
    'play',
    (e) => {
      for (const a of document.querySelectorAll('audio')) {
        if (a !== e.target) a.pause();
      }
    },
    true,
  );
</script>

<style>
  .audio { margin-top: 1.75rem; }

  .audio-abschnitt {
    margin: 0 0 0.75rem;
    color: var(--weinrot);
  }

  .audio-tipp {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold-text);
    font-weight: 600;
  }

  .audio-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .audio-stueck {
    background: #fff;
    border: 1px solid var(--creme-dunkel);
    border-left: 4px solid var(--gold-schmuck);
    border-radius: var(--radius);
    padding: 1rem;
  }

  .audio-titel {
    font-family: var(--schrift-titel);
    color: var(--weinrot);
    font-size: 1.15rem;
    line-height: 1.3;
    margin: 0 0 0.25rem;
  }

  .audio-mitwirkende {
    color: var(--gold-text);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .audio-beschreibung {
    color: var(--text-leise);
    font-size: 0.95rem;
    margin: 0 0 0.25rem;
  }

  audio {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
  }

  .audio-leer {
    background: var(--creme-dunkel);
    border-radius: var(--radius);
    padding: 1.25rem;
    font-style: italic;
    color: var(--text-leise);
  }
</style>
