---
// Kleine Kerzenflamme als Schmuck (reines SVG, keine Bilddatei nötig).
interface Props { groesse?: number }
const { groesse = 40 } = Astro.props;
---
<svg class="flamme" width={groesse} height={groesse * 1.5} viewBox="0 0 40 60" aria-hidden="true" focusable="false">
  <path d="M20 2 C28 16 34 24 34 36 A14 14 0 0 1 6 36 C6 26 13 20 20 2 Z" fill="#e2b65a" />
  <path d="M20 22 C24 30 27 34 27 40 A7 7 0 0 1 13 40 C13 34 16 30 20 22 Z" fill="#fbf6ec" opacity="0.85" />
  <rect x="18.5" y="50" width="3" height="10" rx="1.5" fill="#6b1e2e" />
</svg>
